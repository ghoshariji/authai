{
  "info": {
    "name": "College Management System API",
    "description": "SaaS Multi-Tenant College Management System - Complete API Collection",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "collegeId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register College",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register-college",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"collegeName\": \"Test University\",\n  \"collegeCode\": \"TU001\",\n  \"collegeEmail\": \"info@testuniversity.edu\",\n  \"collegePhone\": \"+1234567890\",\n  \"address\": {\n    \"street\": \"123 Education Ave\",\n    \"city\": \"Knowledge City\",\n    \"state\": \"California\",\n    \"country\": \"USA\",\n    \"pincode\": \"90210\"\n  },\n  \"adminName\": \"John Admin\",\n  \"adminEmail\": \"admin@testuniversity.edu\",\n  \"adminPassword\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Login - Super Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@platform.com\",\n  \"password\": \"SuperAdmin@123\"\n}"
            }
          }
        },
        {
          "name": "Login - College Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@alphauniversity.edu\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh-token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@alphauniversity.edu\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Colleges (Super Admin)",
      "item": [
        {
          "name": "Get All Colleges",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/colleges?page=1&limit=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get College By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/colleges/{{collegeId}}"
          }
        },
        {
          "name": "Get College Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/colleges/{{collegeId}}/stats"
          }
        },
        {
          "name": "Update College",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/colleges/{{collegeId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+9876543210\",\n  \"website\": \"https://alphauniversity.edu\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "Get Plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/subscriptions/plans"
          }
        },
        {
          "name": "Get Current Subscription",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/subscriptions/current"
          }
        },
        {
          "name": "Create Checkout Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/subscriptions/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan\": \"PRO\",\n  \"billingCycle\": \"MONTHLY\"\n}"
            }
          }
        },
        {
          "name": "Cancel Subscription",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/subscriptions/cancel"
          }
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "Get Departments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/departments"
          }
        },
        {
          "name": "Create Department",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/departments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Computer Science\",\n  \"code\": \"CS\",\n  \"description\": \"Department of Computer Science and Engineering\"\n}"
            }
          }
        },
        {
          "name": "Update Department",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/departments/:id",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\"\n}"
            }
          }
        },
        {
          "name": "Delete Department",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/departments/:id"
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Get Students",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/students?page=1&limit=20&search=&departmentId=&classId=",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "search", "value": "" },
                { "key": "departmentId", "value": "", "disabled": true },
                { "key": "classId", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/students",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@alphauniversity.edu\",\n  \"password\": \"Student@123\",\n  \"rollNumber\": \"CS2024001\",\n  \"departmentId\": \"DEPARTMENT_ID\",\n  \"classId\": \"CLASS_ID\",\n  \"year\": 1,\n  \"semester\": 1,\n  \"parentName\": \"Bob Johnson\",\n  \"parentPhone\": \"+1234567890\",\n  \"dob\": \"2005-01-15\",\n  \"gender\": \"FEMALE\",\n  \"admissionDate\": \"2024-08-01\"\n}"
            }
          }
        },
        {
          "name": "Get Student By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/students/:id"
          }
        },
        {
          "name": "Get Student Attendance Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/students/:id/attendance"
          }
        },
        {
          "name": "Get Student Results",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/students/:id/results"
          }
        }
      ]
    },
    {
      "name": "Teachers",
      "item": [
        {
          "name": "Get Teachers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/teachers"
          }
        },
        {
          "name": "Create Teacher",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/teachers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Smith\",\n  \"email\": \"smith@alphauniversity.edu\",\n  \"password\": \"Teacher@123\",\n  \"departmentId\": \"DEPARTMENT_ID\",\n  \"qualification\": \"PhD Computer Science\",\n  \"experience\": 8,\n  \"designation\": \"Associate Professor\",\n  \"joiningDate\": \"2020-01-15\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Mark Bulk Attendance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/attendance/bulk",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": \"CLASS_ID\",\n  \"subjectId\": \"SUBJECT_ID\",\n  \"date\": \"2024-01-15\",\n  \"attendance\": [\n    { \"studentId\": \"STUDENT_ID_1\", \"status\": \"PRESENT\" },\n    { \"studentId\": \"STUDENT_ID_2\", \"status\": \"ABSENT\" },\n    { \"studentId\": \"STUDENT_ID_3\", \"status\": \"LATE\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get Attendance By Class & Date",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/attendance/class/:classId?date=2024-01-15&subjectId=",
              "query": [
                { "key": "date", "value": "2024-01-15" },
                { "key": "subjectId", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Student Attendance Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/attendance/student/:studentId/summary"
          }
        }
      ]
    },
    {
      "name": "Notices",
      "item": [
        {
          "name": "Get Notices",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/notices?type=&page=1",
              "query": [
                { "key": "type", "value": "", "disabled": true },
                { "key": "page", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Create Notice",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/notices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Semester Exams Schedule\",\n  \"content\": \"End semester exams will begin from January 20th. All students are advised to check the detailed schedule on the notice board.\",\n  \"type\": \"EXAM\",\n  \"targetAudience\": \"STUDENTS\",\n  \"expiresAt\": \"2024-02-01\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Exams & Results",
      "item": [
        {
          "name": "Get Exams",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/exams"
          }
        },
        {
          "name": "Create Exam",
          "request": {

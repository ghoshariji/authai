              "raw": "{\n  \"examId\": \"EXAM_ID\",\n  \"results\": [\n    { \"studentId\": \"STUDENT_ID_1\", \"marksObtained\": 85 },\n    { \"studentId\": \"STUDENT_ID_2\", \"marksObtained\": 72 },\n    { \"studentId\": \"STUDENT_ID_3\", \"marksObtained\": 38 }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Get Chat Rooms",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/chat/rooms"
          }
        },
        {
          "name": "Create Chat Room",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/chat/rooms",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CS Year 1 Group\",\n  \"type\": \"GROUP\",\n  \"participants\": [\"USER_ID_1\", \"USER_ID_2\"]\n}"
            }
          }
        },
        {
          "name": "Get Messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/chat/rooms/:roomId/messages?page=1&limit=50",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/chat/rooms/:roomId/messages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello everyone!\",\n  \"type\": \"TEXT\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "Upload File",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/files/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "type", "value": "syllabus", "type": "text" },
                { "key": "relatedId", "value": "SUBJECT_ID", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "Delete File",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/files/:fileId"
          }
        }
      ]
    },
    {
